# Discord Developer Portal で発行した Bot のトークン
DISCORD_TOKEN=

# Whisper API 用の OpenAI API キー
OPENAI_API_KEY=

# 任意: 文字起こしモデル（既定: whisper-1。gpt-4o-transcribe なども指定可）
# WHISPER_MODEL=whisper-1

# 任意: 要約に使う Claude のモデル（未指定なら Claude Code の既定）
# CLAUDE_MODEL=

# 任意: claude コマンドのパス（PATH に無い場合）
# CLAUDE_PATH=

# 任意: 時刻表示のタイムゾーン（既定: Asia/Tokyo）
# TZ=Asia/Tokyo
